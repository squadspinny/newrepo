# ==============================================================================
# Apache / cPanel Configuration for Score Calculator SPA
# Enables direct URL access and page refreshes without 404 errors
# ==============================================================================

# Disable directory browsing
Options -Indexes

# Follow symbolic links
Options +FollowSymLinks

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Direct legacy redirects to canonical targets (avoids redirect chains)
  RewriteRule ^calculator/iqr/?$ /iqr-calculator [R=301,L,NC]
  RewriteRule ^calculator/interquartile-range/?$ /iqr-calculator [R=301,L,NC]
  RewriteRule ^calculator/5e-point-buy/?$ /5e-point-buy-calculator [R=301,L,NC]
  RewriteRule ^calculator/semester-grade/?$ /semester-grade-calculator [R=301,L,NC]
  RewriteRule ^calculator/cumulative-gpa/?$ /cumulative-gpa-calculator [R=301,L,NC]
  RewriteRule ^calculator/marks-percentage/?$ /marks-percentage-calculator [R=301,L,NC]
  RewriteRule ^calculator/grade-curve/?$ /grade-curve-calculator [R=301,L,NC]
  RewriteRule ^calculator/mean-absolute-deviation/?$ /mean-absolute-deviation-calculator [R=301,L,NC]
  RewriteRule ^calculator/ap-environmental-science/?$ /apes-score-calculator [R=301,L,NC]
  RewriteRule ^calculator/ap-computer-science-a/?$ /ap-csa-score-calculator [R=301,L,NC]
  RewriteRule ^calculator/ap-us-history/?$ /apush-score-calculator [R=301,L,NC]
  RewriteRule ^calculator/ap-english-language/?$ /ap-lang-score-calculator [R=301,L,NC]
  RewriteRule ^calculator/ap-english-literature/?$ /ap-lit-score-calculator [R=301,L,NC]
  RewriteRule ^calculator/ap-physics-?1?/?$ /ap-physics-1-score-calculator [R=301,L,NC]
  RewriteRule ^calculator/ap-macroeconomics/?$ /ap-macro-score-calculator [R=301,L,NC]
  RewriteRule ^calculator/ap-microeconomics/?$ /ap-micro-score-calculator [R=301,L,NC]
  RewriteRule ^calculator/ap-us-government/?$ /ap-government-score-calculator [R=301,L,NC]
  RewriteRule ^calculator/ap-computer-science-principles/?$ /ap-cs-principles-score-calculator [R=301,L,NC]

  # Default fallback for standard legacy /calculator/<id> to /<id>-score-calculator
  RewriteRule ^calculator/(.*)$ /$1-score-calculator [R=301,L,NC]

  # Direct favicon and icon requests to /favicons/ directory
  RewriteRule ^favicon\.ico$ /favicons/favicon.ico [L]
  RewriteRule ^apple-touch-icon\.png$ /favicons/apple-touch-icon.png [L]

  # 2. Do not rewrite existing files or directories
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 3. Route all other requests to index.html for client-side routing (BrowserRouter)
  RewriteRule ^ index.html [L]
</IfModule>

# ==============================================================================
# Browser Caching & GZIP Compression for Fast Performance
# ==============================================================================
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # HTML files - do not cache heavily so updates reflect immediately
  ExpiresByType text/html "access plus 0 seconds"

  # Static assets (Vite hashed bundles)
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType application/zip "access plus 1 month"
</IfModule>
